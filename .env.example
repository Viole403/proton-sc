# =============================================================================
# proton-sc — environment variables
# Salin ke .env dan isi nilai yang sesuai. JANGAN commit file .env.
# =============================================================================

# --- Python / runtime ---
# Jalur ke python venv (default: ./venv/bin/python, fallback python3 sistem)
#BRUTALISM_VENV=

# Jalur ke mitmdump (default: ./venv/bin/mitmdump, fallback mitmdump sistem)
#BRUTALISM_MITMDUMP=

# Jalur ke browser Chrome/Chromium (auto-deteksi bila dikosongkan)
#BRUTALISM_CHROME_BIN=

# Port router mitmproxy (default: 8095)
#BRUTALISM_ROUTER_PORT=8095

# Display Xvfb (default: :99)
#DISPLAY=:99

# --- Proxy (Geonode / Decodo / dst) ---
# File proxy per-akun (format host:port:user:pass, satu per baris)
#BRUTALISM_PROXY_FILE=data/proxies.txt

# Proxy upstream untuk router (host:port)
#GEONODE_PROXY=

# Auth upstream (user:pass)
#GEONODE_AUTH=

# --- API key layanan alias email (untuk recovery email / OTP) ---
HEADMAIL_KEY=
EVILMAIL_KEY=

# --- SMS (opsional) ---
SMSBOWER_KEY=
SMSBOWER_COUNTRY=

# --- Captcha solver (opsional) ---
TWOCAPTCHA_KEY=
CAPSOLVER_KEY=
CAPSOLVER_TASK_TYPE=ImageToText

# --- Fitur ---
# Aktifkan evilmail sebagai provider alias (default: headmail)
#EVILMAIL_AKTIF=1

# Domain whitelist (koma-separated, kosongkan untuk semua dari API)
#DOMAIN_HIDUP=

# --- Debug / perilaku ---
# Aktifkan noise render canvas/WebGL (default: 0/mati)
#NOISE_RENDER=0

# Aktifkan mode forge fp_forge (default: off — disarankan OFF untuk stabilitas)
#FORGE_MODE=off

# Aktifkan UA spoof via CDP (default: 0/mati — biarkan Chrome native)
#UA_SPOOF=0

# Aktifkan patchright (default: 0 — playwright asli disarankan)
#USE_PATCHRIGHT=0

# Aktifkan debug HV (capture respons jaringan utuh, hanya untuk diagnosa)
#DEBUG_HV=0

# Aktifkan debug capture captcha (simpan PNG ke analysis/dbg-captcha)
#DBG_CAPTCHA=0

# Izinkan egress direct (tanpa proxy) — DISARANKAN 0 untuk stabilitas akun
#IZINKAN_DIRECT=0

# --- Anti-suspend mitigasi ---
# Jeda menik antar akun dalam satu batch (anti bulk-signup clustering ML Proton)
# Disarankan: 5-15 menit per akun, satu proxy residential per akun
#ANTI_SUSPEND_DELAY_MIN=10

# Aktifkan naikkan sesi (POST /auth) setelah /users 200 — DIMATIKAN default
# karena mengganggu jendela kritis SPA pasca-signup (bisa buang akun).
# Aktifkan hanya jika tahu apa yang dilakukan: NAIKKAN_SESI=1
#NAIKKAN_SESI=0

# --- Versi Proton (diupdate otomatis dari bundle, jangan diubah kecuali perlu) ---
#PROTON_MAIL_DOMAIN=protonmail.com
#SIGNUP_APP_VERSION=web-account@5.0.433.0

# --- GitHub registration (branch feat/github-registration) ---
# Proxy GitHub (wajib, DataDome ketat — satu proxy residential per akun)
#GH_PROXY=
# BRUTALISM_PROXY_FILE=data/proxies.txt (digunakan jika GH_PROXY kosong)

# Token solver CAPTCHA FunCaptcha/Arkose Labs (opsional — placeholder)
#OCTOCAPTCHA_TOKEN=

# Jeda menit antar pendaftaran GitHub (anti-bulk clustering)
#GITHUB_ANTI_SUSPEND_DELAY_MIN=5

# Negara default untuk formulir signup GitHub
#GITHUB_NEGARA=ID
